# Discord Bot Token (REQUIRED for the Multi-User Discord Bot)
# Create your bot application at: https://discord.com/developers/applications
DISCORD_BOT_TOKEN=

# Maximum number of users that can run quests concurrently (Default: 5)
MAX_CONCURRENT_USERS=5

# Optional: User token (only used if running standalone CLI selfbot mode without a bot token)
TOKEN=

# Optional: Webhook URL for quest notifications
WEBHOOK_URL=

# Optional: YesCaptcha API key for captcha solving
YES_CAPTCHA_API_KEY=